# Variables de Activate Guajira.
#
# Copia este archivo a .env para docker compose. En Railway NO se sube ningun
# archivo: cada variable se define en la pestana Variables del servicio.
#
#   cp .env.example .env
#
# Ninguna de estas claves debe acabar en git.


# =============================================================================
# BACKEND (servicio Django)
# =============================================================================

# Obligatoria en produccion. Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambiala-por-una-clave-larga-y-aleatoria

# Nunca True en produccion: la pagina de error muestra rutas, consultas y
# variables de entorno a cualquiera que provoque un fallo.
DEBUG=False

# Dominios que el backend acepta servir, separados por comas. Railway anade
# solo el suyo a traves de RAILWAY_PUBLIC_DOMAIN.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origenes de confianza para CSRF. Django 4 exige el esquema (https://).
CSRF_TRUSTED_ORIGINS=http://localhost:4200

# De donde se aceptan llamadas del navegador. Aqui va el dominio del FRONTEND,
# no el del backend.
CORS_ALLOWED_ORIGINS=http://localhost:4200


# --- Base de datos -----------------------------------------------------------
# En Railway basta con referenciar la variable del servicio MySQL:
#   MYSQL_URL=${{MySQL.MYSQL_URL}}
# y las cuatro de abajo sobran.
MYSQL_URL=

# Alternativa por partes, con los mismos nombres que usa Railway.
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLDATABASE=peakfit
MYSQLUSER=root
MYSQLPASSWORD=

# Contrasena de root del MySQL que levanta docker compose (solo local).
MYSQL_ROOT_PASSWORD=desarrollo


# --- Archivos subidos --------------------------------------------------------
# El disco de un contenedor se borra en cada despliegue. En Railway hay que
# montar un volumen y apuntar aqui su ruta, o las fotos de perfil desapareceran
# con el siguiente despliegue.
MEDIA_ROOT=/datos/media


# --- Arranque ----------------------------------------------------------------
# Aplica las migraciones antes de servir. Comodo con una sola instancia;
# con varias replicas conviene dejarlo en false y migrar a mano.
RUN_MIGRATIONS=false

# Siembra roles, recursos, permisos y parametricas. Solo la primera vez.
RUN_SEED=false

# Procesos de gunicorn. Railway asigna poca CPU en el plan basico: 2-3 va bien.
WEB_CONCURRENCY=3
WEB_TIMEOUT=120


# --- Servicios externos ------------------------------------------------------
GEMINI_API_KEY=

# Correo. ATENCION: en el codigo habia una contrasena de aplicacion de Gmail
# escrita a mano y sigue en el historial de git. Revocala en la cuenta de
# Google y pon una nueva aqui.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Notificaciones push. Las claves que quedaron en el codigo tambien estan en el
# historial: genera unas nuevas con Backend/config/config/generar_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=rdamianquintero@uniguajira.edu.co

# Cola de tareas y cache. Vacias, Django usa memoria del proceso.
REDIS_URL=
MEMCACHED_LOCATION=


# =============================================================================
# FRONTEND (servicio Angular + nginx)
# =============================================================================

# Direccion publica del BACKEND. Se hornea al compilar, no al arrancar: si la
# cambias hay que reconstruir la imagen (en Railway, volver a desplegar).
API_URI=http://localhost:8000
